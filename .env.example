# ─── Core deterministic auditor ────────────────────────────────────────────
# The core audit (python3 -m contrib_audit check ...) needs no API key.
# Do not create or commit a real .env file.

# ─── Optional experimental ADK layer (review_agent/) ───────────────────────
# Required only when running `adk web` or `adk run review_agent`.
# Install the extra deps first:  pip install -r requirements-agent.txt
# Copy this file to .env and fill in your key — never commit the real .env.

GOOGLE_API_KEY=your_google_api_key_here

# Model to use (optional — defaults to gemini-2.5-flash if not set).
# MODEL_NAME=gemini-2.5-flash
